# Postgres connection for the read model. Free-tier hosted Postgres
# (e.g. https://neon.tech) works fine for this — no VPS required.
DATABASE_URL="postgresql://user:password@localhost:5432/eatovr_proof"

# Soroban / Stellar network
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# The deployed AttestationRegistry contract id (see ../contracts/README.md)
CONTRACT_ID="CDII3ONLMNCEYTVO77V2X5WAZRAPBIJRYFGCETQ42X62CDXJGDKGUH2R"

PORT=3900
INDEXER_POLL_INTERVAL_MS=5000

# Pays network fees on behalf of passkey-controlled smart wallets,
# which don't hold XLM themselves. This key has no authority over any
# attestation — it only ever pays transaction fees.
SPONSOR_SECRET=""

# --- Sponsor Food (see docs/BUILDATHON-PLAN.md) ---

# Trustless Work's API key — request one at backoffice.trustlesswork.com
# (log in with a Stellar wallet, fill in a "Use Case", choose testnet,
# "Request an API Key"). Format: id.secret. Left blank, Sponsor Food's
# routes fail clearly; everything else in this service still starts
# fine without it.
#
# This key only authenticates against the v1 host below — confirmed
# live: `/helper/get-escrows-by-signer` returned 200 with this key,
# while the v2 beta API (beta.api.trustlesswork.com) 401'd it despite
# the route shapes looking plausible from its docs. The two APIs use
# different credentials; don't assume they're interchangeable.
TRUSTLESS_WORK_API_KEY=""
TRUSTLESS_WORK_BASE_URL="https://dev.api.trustlesswork.com"

# Eatovr's own platform settlement key for Sponsor Food — approves and
# releases each unit's escrow, and is where released testnet USDC
# lands. Not a donor key, not a vendor key. Needs testnet XLM (for
# fees) and a USDC trustline (see usdcIssuer below).
PLATFORM_SECRET=""

# Reflector's CEX/DEX feed (testnet) — has a real USDC/USD pair,
# unlike the Fiat FX feed which has no NGN pair at all (verified live).
REFLECTOR_CEX_DEX_CONTRACT_ID="CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63"

# Testnet USDC's Stellar Asset Contract id — derived via
# `stellar contract id asset --asset "USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5" --network testnet`.
# Used for the donor/platform's own trustline and balance checks.
USDC_CONTRACT_ID="CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA"

# Trustless Work's v1 escrow `trustline.address` field wants the
# asset's issuer address (G...), not its Stellar Asset Contract id
# (C...) — a real, documented gotcha, not guessed.
USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
