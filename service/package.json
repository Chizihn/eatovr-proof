{
  "name": "attestation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relays Eatovr Proof pickup confirmations into the AttestationRegistry Soroban contract, and indexes finalized records into a Postgres read model.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@stellar/stellar-sdk": "17.4.0",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
