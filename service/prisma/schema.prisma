generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The read model. Source of truth is always the chain; this table is
// rebuilt from `claimed`/`finalized` contract events by the indexer, never
// written to directly by the relay routes.
//
// Keyed by `orderId` (Eatovr's own order id), not an on-chain-minted
// sequential id — the contract itself is keyed this way now (see
// contracts/attestation-registry/src/lib.rs's `DataKey::Claim` comment)
// specifically so the recipient's `confirm_pickup` can be signed at
// checkout, before `claim_pickup` ever runs. See `PendingConfirmation`
// below for the other half of that flow.
model Attestation {
  orderId       String    @id @map("order_id")
  vendor        String
  recipient     String
  itemType      String    @map("item_type")
  quantity      Int
  status        String // "Pending" | "Finalized"
  claimedAt     DateTime  @map("claimed_at")
  confirmedAt   DateTime? @map("confirmed_at")
  claimTxHash   String    @map("claim_tx_hash")
  confirmTxHash String?   @map("confirm_tx_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("attestations")
}

// A recipient's `confirm_pickup` authorization, signed with their
// passkey at checkout — before the vendor has claimed anything, while
// the recipient is already in the app paying. Stored here, unsubmitted,
// until the indexer observes the matching `claimed` event for the same
// `orderId`, at which point it submits this automatically via the
// relayer (`relayFuncAndAuth`) — no further action from the recipient.
// This is the actual trust/UX trade this flow makes: the signature
// still genuinely comes from the recipient's own passkey (unchanged
// security property); only *when it gets submitted on-chain* is
// decoupled from *when it was signed*.
model PendingConfirmation {
  orderId      String    @id @map("order_id")
  recipient    String
  // base64 XDR: xdr.HostFunction (the confirm_pickup invocation) and
  // its one xdr.SorobanAuthorizationEntry (the recipient's signature) —
  // the exact shape `relayFuncAndAuth` already takes.
  funcXdr      String    @map("func_xdr")
  authXdr      String[]  @map("auth_xdr")
  submittedAt  DateTime? @map("submitted_at")
  submitTxHash String?   @map("submit_tx_hash")
  submitError  String?   @map("submit_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("pending_confirmations")
}

// Where the indexer left off, so a restart resumes instead of
// re-scanning the whole ledger history.
model IndexerCursor {
  id         Int      @id @default(1)
  lastLedger BigInt   @map("last_ledger")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("indexer_cursor")
}

// A donor's "sponsor N meals" purchase. Not a raw currency amount — a
// fixed tier (see sponsorship/tiers.ts) that creates `unitCount`
// discrete, identically-valued `SponsorshipUnit`s up front. Nothing
// here ever splits a value at redemption time; the contract (and this
// read model) only ever track whole units moving Pending -> Available
// -> Claimed -> Redeemed. See docs/BUILDATHON-PLAN.md's Sponsor Food
// section for why: no fractional-remainder problem, no on-chain math
// over an arbitrary amount across however many people show up.
//
// Trustless Work has no cross-vendor split and a single-release
// escrow pays only its one fixed receiver — so each unit gets its own
// escrow (receiver: Eatovr's own platform settlement address, not the
// donor and not the eventual vendor, which isn't known until a
// customer claims the unit). Released automatically when that unit's
// order finalizes on-chain (see indexer/run.ts). Paying the specific
// fulfilling vendor onward from the platform address is a real,
// separate follow-on transfer, not wired this week — same honesty
// standard as the SEP-24 settlement note elsewhere in this repo.
model SponsorshipBatch {
  id              String    @id @default(uuid())
  donorPublicKey  String    @map("donor_public_key")
  region          String? // optional targeting; null = anywhere Eatovr operates
  unitCount       Int       @map("unit_count")
  unitValueUsdc   String    @map("unit_value_usdc") // decimal string, e.g. "2.0000000"
  // The USD/USDC sanity-check read taken from Reflector's CEX/DEX feed
  // at creation time (see reflector/client.ts) — a real oracle call,
  // not decoration. NGN -> USD is a separately-documented fixed demo
  // rate (see sponsorship/tiers.ts) because Reflector's Fiat FX feed
  // has no NGN pair at all, verified live against testnet.
  reflectorUsdPrice String? @map("reflector_usd_price")
  status          String    @default("Funding") @map("status") // "Funding" | "Active" | "Depleted"
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  units SponsorshipUnit[]

  @@map("sponsorship_batches")
}

// One redeemable meal within a batch. `escrowContractId` is this
// unit's own Trustless Work single-release escrow (one per unit, see
// `SponsorshipBatch`'s doc comment for why) — deployed and funded by
// the donor's wallet at sponsor time, released to the platform
// settlement address when `claimedOrderId`'s order finalizes.
model SponsorshipUnit {
  id               String    @id @default(uuid())
  batchId          String    @map("batch_id")
  batch            SponsorshipBatch @relation(fields: [batchId], references: [id])
  index            Int
  status           String    @default("Pending") // "Pending" | "Available" | "Claimed" | "Redeemed"
  escrowContractId String?   @map("escrow_contract_id")
  fundingTxHash    String?   @map("funding_tx_hash")
  // Set once a customer claims this unit in the demo "claim a
  // sponsored meal" surface — the orderId then goes through the exact
  // same unmodified claim_pickup/confirm_pickup flow as any order.
  claimedOrderId   String?   @unique @map("claimed_order_id")
  claimedAt        DateTime? @map("claimed_at")
  releaseTxHash    String?   @map("release_tx_hash")
  releasedAt       DateTime? @map("released_at")
  releaseError     String?   @map("release_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([batchId, index])
  @@map("sponsorship_units")
}
